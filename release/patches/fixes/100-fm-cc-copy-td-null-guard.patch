--- a/drivers/net/ethernet/freescale/sdk_fman/Peripherals/FM/Pcd/fm_cc.c
+++ b/drivers/net/ethernet/freescale/sdk_fman/Peripherals/FM/Pcd/fm_cc.c
@@ -6170,9 +6170,27 @@
 }
 uint32_t copy_td_to_ccbase(void *handle, t_Handle p_CcTreeTmp, uint32_t *node)
 {
 	struct en_exthash_info *info;
 	struct en_exthash_node *ptr, *ccptr;
 	t_FmPcd *p_FmPcd;
 	uint32_t ii;
 
+	/* ASK-6.6: When dpa_app/fmc emits a CC-root tree entry whose
+	 * nextEngine is e_FM_PCD_CC but whose h_CcNode handle was
+	 * produced by FM_PCD_MatchTableSet()/FM_PCD_HashTableSet()
+	 * (i.e. a non-EHASH t_FmPcdCcNode *), or even a NULL handle,
+	 * the unconditional cast to (struct en_exthash_info *) below
+	 * NULL-derefs at info->h_Ad (offset 0x18) inside
+	 * FM_PCD_CcRootBuild(). The userspace fmc/fmlib in this image
+	 * does not flag externalHash on every CC entry, so this case
+	 * is reachable in normal boot. Guard the cast so the tree
+	 * build keeps going for the non-EHASH entries instead of
+	 * SIGSEGV-ing dpa_app and aborting CDX bufpool init.
+	 */
+	if (!handle) {
+		if (node)
+			*node = 0;
+		return 0;
+	}
+
 	info = (struct en_exthash_info *)handle;
 	ptr = (struct en_exthash_node  *)&info->node;
 	ccptr = (struct en_exthash_node  *)p_CcTreeTmp;
