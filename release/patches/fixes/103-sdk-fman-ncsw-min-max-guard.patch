SDK FMan ncsw_ext.h: guard MIN/MAX redefinition

drivers/net/ethernet/freescale/sdk_fman/inc/ncsw_ext.h unconditionally
defines MIN(a,b) and MAX(a,b).  Mainline 6.6 also defines MIN/MAX in
<linux/minmax.h> (pulled in via <linux/kernel.h> -> <linux/string.h>),
which makes any TU that includes both fail under -Werror:

  ./drivers/net/ethernet/freescale/sdk_fman/inc/ncsw_ext.h:165:
    error: "MIN" redefined [-Werror]
  ./drivers/net/ethernet/freescale/sdk_fman/inc/ncsw_ext.h:166:
    error: "MAX" redefined [-Werror]

Wrap the SDK definitions in #ifndef so the kernel's versions take
precedence when present.

--- a/drivers/net/ethernet/freescale/sdk_fman/inc/ncsw_ext.h
+++ b/drivers/net/ethernet/freescale/sdk_fman/inc/ncsw_ext.h
@@ -162,8 +162,12 @@
 #define CYCLES_TO_PSEC(cycles,clk)  (((cycles) * 1000000) / (clk))
 
 /* Min, Max macros */
+#ifndef MIN
 #define MIN(a,b)    ((a) < (b) ? (a) : (b))
+#endif
+#ifndef MAX
 #define MAX(a,b)    ((a) > (b) ? (a) : (b))
+#endif
 #define IN_RANGE(min,val,max) ((min)<=(val) && (val)<=(max))
 
 #define ABS(a)  ((a<0)?(a*-1):a)
