diff -urN ask-pristine/fci/lib/install-sh /root/lts_6.6_ls1046a/work/reference/fci/lib/install-sh
--- a/fci/lib/install-sh	1970-01-01 00:00:00.000000000 +0000
+++ b/fci/lib/install-sh	2026-04-20 15:07:08.016837010 +0000
@@ -0,0 +1,294 @@
+#!/bin/sh
+#
+# install - install a program, script, or datafile
+#
+# This originates from X11R5 (mit/util/scripts/install.sh), which was
+# later released in X11R6 (xc/config/util/install.sh) with the
+# following copyright and license.
